# Copiază la rădăcina repo-ului ca `.env.vps` și completează valorile.
# Pornește: docker compose -f docker-compose.vps.yml --env-file .env.vps up -d --build
#
# IMPORTANT Docker: imaginea backend NU conține `backend/.env` (e exclus la build).
# Copiază aici din `backend/.env` ce ai nevoie: JWT_SECRET, SMTP, GOOGLE_CLIENT_ID, chei API, etc.
# `DATABASE_URL` / `REDIS_URL` din fișier sunt ignorate în favoarea valorilor din docker-compose.
#
# Fără domeniu, doar IP (același nginx pe port 80):
#   APP_BASE_URL=http://203.0.113.7
# Lăsă gol `NEXT_PUBLIC_API_URL` → browser apelează /api pe același host (IP sau domeniu).
#
# `PUBLIC_HOST` fără https (ex: www.zecelainfo.ro) — opțional, documentație / alte scripturi.

# NEXT_PUBLIC_API_URL=

# --- Postgres (folosit și de docker-compose pentru interpolare) ---
POSTGRES_DB=zecelainfo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=schimba_cu_parola_puternica

PUBLIC_HOST=www.zecelainfo.ro
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Backend (vezi și backend/.env.example) — restul variabilelor tale ---
# DATABASE_URL și REDIS_URL sunt suprascrise de docker-compose pentru serviciile din rețea.
# Cu IP: http://IP_PUBLIC (fără slash final). Cu domeniu: https://www.exemplu.ro
APP_BASE_URL=https://www.zecelainfo.ro
NODE_ENV=production
PORT=4000

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

REVOLUT_BASE_URL=
REVOLUT_SECRET_KEY=
REVOLUT_API_VERSION=

SMARTBILL_BASE_URL=
SMARTBILL_USERNAME=
SMARTBILL_TOKEN=
SMARTBILL_COMPANY_VAT_CODE=
SMARTBILL_SERIES_NAME=

JUDGE_SECRET=acelasi_secret_ca_la_judge_daca_il_pornesti

# Meditații / Revolut secundar — dacă le folosești, copiază din backend/.env
